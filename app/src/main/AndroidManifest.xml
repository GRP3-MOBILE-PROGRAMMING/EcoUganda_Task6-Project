<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Lets performance traces tag network_type (wifi / cell_3g / cell_2g / offline) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Android 13+: needed to show "new field report" push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:name=".EcoUgandaApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_eco_logo"
        android:roundIcon="@drawable/ic_eco_logo"
        android:label="EcoUganda"
        android:supportsRtl="true"
        android:theme="@style/Theme.EcoUganda">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.App.Starting">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Deep link from push notifications: ecouganda://reports/{reportId} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ecouganda" android:host="reports"/>
            </intent-filter>

        </activity>

        <!-- Firebase Cloud Messaging: builds the report notification -->
        <service
            android:name=".notifications.EcoMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="field_reports"/>

    </application>
</manifest>
