<resources>
    <style name="Theme.EcoUganda" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/eco_green</item>
        <item name="android:statusBarColor">@color/eco_green_dark</item>
        <item name="android:navigationBarColor">@color/eco_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/eco_background</item>
    </style>

    <!-- Professional Splash Screen Theme using the exact application logo -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_eco_logo</item>
        <item name="windowSplashScreenBackground">@color/eco_white</item>
        <item name="postSplashScreenTheme">@style/Theme.EcoUganda</item>
    </style>
</resources>