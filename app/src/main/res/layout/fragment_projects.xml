<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/projects_title"
            android:textColor="@color/eco_text"
            android:textSize="21sp"/>

        <TextView
            android:id="@+id/active_projects_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/active_projects_count"
            android:textColor="@color/eco_muted"
            android:textSize="12sp"/>

        <EditText
            android:id="@+id/search_projects"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="12dp"
            android:hint="@string/search_projects_hint"
            android:textSize="13sp"
            android:singleLine="true"
            android:inputType="text"
            android:autofillHints="none"
            android:background="@drawable/bg_card"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="14dp"
            android:background="@color/eco_green_soft">

            <WebView
                android:id="@+id/project_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/active_projects_label"
            android:textColor="@color/eco_text"
            android:textSize="18sp"/>

        <!-- Container for dynamic project items -->
        <LinearLayout
            android:id="@+id/projects_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Items will be added here -->
        </LinearLayout>

    </LinearLayout>
</ScrollView>