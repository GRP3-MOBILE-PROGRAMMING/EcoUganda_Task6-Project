<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/projects_title"
            android:textColor="@color/eco_text"
            android:textSize="21sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/active_projects_count"
            android:textColor="@color/eco_muted"
            android:textSize="12sp"/>

        <EditText
            android:id="@+id/search_projects"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="12dp"
            android:hint="@string/search_projects_hint"
            android:textSize="13sp"
            android:singleLine="true"
            android:inputType="text"
            android:autofillHints="none"
            android:background="@drawable/bg_card"/>

        <!-- Actual interactive OpenStreetMap -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="14dp"
            android:background="@color/eco_green_soft">

            <WebView
                android:id="@+id/project_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/active_projects_label"
            android:textColor="@color/eco_text"
            android:textSize="18sp"/>

        <!-- Project 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/project_kiryandongo"
                android:textColor="@color/eco_text"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kiryandongo_details"
                android:textColor="@color/eco_muted"
                android:textSize="11sp"/>

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="71"
                android:progressTint="@color/eco_green"
                android:progressBackgroundTint="@color/eco_green_soft"/>
        </LinearLayout>

        <!-- Project 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rwenzori_title"
                android:textColor="@color/eco_text"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rwenzori_details"
                android:textColor="@color/eco_muted"
                android:textSize="11sp"/>

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="46"
                android:progressTint="@color/eco_green"
                android:progressBackgroundTint="@color/eco_green_soft"/>
        </LinearLayout>

        <!-- Project 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/biogas_title"
                android:textColor="@color/eco_text"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/biogas_details"
                android:textColor="@color/eco_muted"
                android:textSize="11sp"/>

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="18"
                android:progressTint="@color/eco_green"
                android:progressBackgroundTint="@color/eco_green_soft"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
