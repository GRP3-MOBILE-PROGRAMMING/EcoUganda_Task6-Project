<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/eco_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Green Schools Program"
            android:textSize="21sp"
            android:textColor="@color/eco_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clean energy and tree-planting progress"
            android:textSize="12sp"
            android:textColor="@color/eco_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Participating schools"
                        android:textSize="11sp"
                        android:textColor="@color/eco_muted" />

                    <TextView
                        android:id="@+id/total_schools_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="326"
                        android:textSize="25sp"
                        android:textColor="@color/eco_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Across 48 districts"
                        android:textSize="11sp"
                        android:textColor="@color/eco_muted" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trees planted"
                        android:textSize="11sp"
                        android:textColor="@color/eco_muted" />

                    <TextView
                        android:id="@+id/total_trees_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="84,600"
                        android:textSize="25sp"
                        android:textColor="@color/eco_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reported this year"
                        android:textSize="11sp"
                        android:textColor="@color/eco_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/search_schools"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="12dp"
            android:hint="⌕ Search by school or district"
            android:textSize="13sp"
            android:background="@drawable/bg_card"
            android:autofillHints="none"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Participating schools"
            android:textSize="18sp"
            android:textColor="@color/eco_text"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:id="@+id/schools_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Dynamic school items will be added here -->
        </LinearLayout>

    </LinearLayout>
</ScrollView>