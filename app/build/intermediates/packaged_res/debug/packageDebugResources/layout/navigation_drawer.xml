<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobile_drawer"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:background="@color/eco_white"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="22dp"
            android:background="@color/eco_green">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="E"
                android:textSize="25sp"
                android:textColor="@color/eco_green"
                android:background="@drawable/bg_green_soft" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="EcoUganda"
                android:textColor="@color/eco_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GREEN NAVIGATOR"
                android:textColor="@color/eco_green_soft"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="NEMA • UREA • NGO partners"
                android:textColor="@color/eco_white"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nav_dashboard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:text="⌂    Dashboard"
            android:textColor="@color/eco_text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/nav_projects"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:text="▦    Projects"
            android:textColor="@color/eco_text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/nav_schools"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:text="♧    Green Schools"
            android:textColor="@color/eco_text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/nav_reports"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:text="▤    Districts / Reports"
            android:textColor="@color/eco_text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/nav_settings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:text="⚙    Settings"
            android:textColor="@color/eco_text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:layout_marginTop="50dp"
            android:text="Offline sync: enabled"
            android:textColor="@color/eco_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
